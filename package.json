{
  "name": "pi-interactive-subagents",
  "version": "3.7.2",
  "description": "Interactive subagents for pi - spawn, orchestrate, and manage sub-agent sessions in Herdr",
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "author": "Amos Blomqvist",
  "repository": {
    "type": "git",
    "url": "https://github.com/amosblomqvist/pi-interactive-subagents"
  },
  "type": "module",
  "scripts": {
    "test": "node --test test/test.ts test/herdr-reliability.test.ts",
    "test:cleanup-herdr": "node test/integration/cleanup-herdr-test-panes.ts",
    "test:herdr-raw": "node --test test/integration/herdr-raw-surface.test.ts",
    "test:integration": "node --test --test-concurrency=1 test/integration/*.test.ts",
    "typecheck": "tsc"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "pi": {
    "extensions": [
      "./pi-extension/subagents/index.ts"
    ]
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.3",
    "@earendil-works/pi-tui": "^0.84.3",
    "typebox": "^1.3.7",
    "typescript": "^5.9.3"
  }
}
